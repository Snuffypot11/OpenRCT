<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Company>OpenRCT Contributors</Company>
    <Product>OpenRCT — Open Source Right Click Tools for MECM</Product>
    <Copyright>Copyright (c) 2026 OpenRCT Contributors. Licensed under the MIT License.</Copyright>
    <Version>0.1.7</Version>
    <AssemblyVersion>0.1.7.0</AssemblyVersion>
    <FileVersion>0.1.7.0</FileVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Allow building net48 class libraries on Linux/macOS CI using Microsoft's official reference assemblies -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48' AND '$(OS)' != 'Windows_NT'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
