<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Company>OpenCMTools Contributors</Company>
    <Product>OpenCMTools — Open Source Endpoint &amp; Console Tools for MECM</Product>
    <Copyright>Copyright (c) 2026 OpenCMTools Contributors. Licensed under the MIT License.</Copyright>
    <Version>0.3.0</Version>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Fork-friendly update source: automatically populated from GitHub Actions GITHUB_REPOSITORY when built in CI; blank for local builds -->
    <OpenCMToolsUpdateRepository Condition="'$(OpenCMToolsUpdateRepository)' == ''">$(GITHUB_REPOSITORY)</OpenCMToolsUpdateRepository>
  </PropertyGroup>

  <ItemGroup Condition="'$(OpenCMToolsUpdateRepository)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>UpdateRepository</_Parameter1>
      <_Parameter2>$(OpenCMToolsUpdateRepository)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Allow building net48 class libraries on Linux/macOS CI using Microsoft's official reference assemblies -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48' AND '$(OS)' != 'Windows_NT'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
