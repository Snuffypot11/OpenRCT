<UserControl x:Class="OpenRCT.UI.Controls.MultiSelectDropdown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <ToggleButton x:Name="DropToggle"
                  Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource BorderBrushSubtle}"
                  BorderThickness="1"
                  HorizontalContentAlignment="Stretch"
                  MinHeight="28"
                  Padding="8,3">
      <DockPanel>
        <TextBlock Text="▾" DockPanel.Dock="Right" Margin="6,0,0,0" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
        <TextBlock x:Name="SummaryText"
                   Text="(None selected)"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   VerticalAlignment="Center" />
      </DockPanel>
    </ToggleButton>

    <Popup IsOpen="{Binding IsChecked, ElementName=DropToggle}"
           PlacementTarget="{Binding ElementName=DropToggle}"
           Placement="Bottom"
           StaysOpen="False"
           AllowsTransparency="True"
           MinWidth="{Binding ActualWidth, ElementName=DropToggle}"
           MaxHeight="300">
      <Border Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrushSubtle}"
              BorderThickness="1"
              Padding="6">
        <DockPanel>
          <TextBox x:Name="SearchBox"
                   DockPanel.Dock="Top"
                   Margin="0,0,0,6"
                   Padding="6,3"
                   TextChanged="SearchBox_TextChanged" />
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="All" Style="{StaticResource StandardButton}" Padding="8,2" Margin="0,0,6,0" Click="SelectAll_Click" />
            <Button Content="None" Style="{StaticResource StandardButton}" Padding="8,2" Click="SelectNone_Click" />
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ItemsList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <CheckBox Content="{Binding DisplayText}"
                            IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            Margin="2,3"
                            Checked="ItemCheckChanged"
                            Unchecked="ItemCheckChanged" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>
