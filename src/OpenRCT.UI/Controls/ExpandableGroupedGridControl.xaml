<UserControl x:Class="OpenRCT.UI.Controls.ExpandableGroupedGridControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OpenRCT.UI.Controls">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <controls:BindingProxy x:Key="GridProxy" />
  </UserControl.Resources>

  <DataGrid x:Name="ParentGrid"
            Style="{DynamicResource OpenRctDataGrid}"
            IsReadOnly="False"
            RowHeight="NaN"
            MinRowHeight="30"
            RowDetailsVisibilityMode="Visible"
            SelectionMode="Extended"
            MouseDoubleClick="ParentGrid_MouseDoubleClick">
    <DataGrid.Columns>
      <!-- Expand / Collapse Chevron Column -->
      <DataGridTemplateColumn Width="34" CanUserResize="False" CanUserSort="False">
        <DataGridTemplateColumn.Header>
          <Button x:Name="ExpandAllButton"
                  Content="&#x25B8;"
                  ToolTip="Expand / Collapse All"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="2,0"
                  Cursor="Hand"
                  Foreground="{DynamicResource PrimaryTextBrush}"
                  Click="ExpandAllButton_Click" />
        </DataGridTemplateColumn.Header>
        <DataGridTemplateColumn.CellTemplate>
          <DataTemplate>
            <Button Content="{Binding ExpandGlyph}"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{DynamicResource PrimaryTextBrush}"
                    FontSize="13"
                    Padding="4,0"
                    Cursor="Hand"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Click="ToggleExpandRow_Click" />
          </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>

      <!-- Select All / Group Checkbox Column -->
      <DataGridTemplateColumn Width="36" CanUserResize="False" CanUserSort="False">
        <DataGridTemplateColumn.Header>
          <CheckBox x:Name="SelectAllCheckBox"
                    ToolTip="Select / Deselect All"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Click="SelectAllCheckBox_Click" />
        </DataGridTemplateColumn.Header>
        <DataGridTemplateColumn.CellTemplate>
          <DataTemplate>
            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      IsThreeState="False"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
          </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>

      <!-- Main Item Columns -->
      <DataGridTextColumn x:Name="NameColumn"
                          Header="Name"
                          Binding="{Binding Name}"
                          IsReadOnly="True"
                          Width="2*" />
      <DataGridTextColumn x:Name="SecondaryColumn"
                          Header="Publisher"
                          Binding="{Binding SecondaryInfo}"
                          IsReadOnly="True"
                          Width="1.1*" />
      <DataGridTextColumn x:Name="VersionColumn"
                          Header="Version"
                          Binding="{Binding Version}"
                          IsReadOnly="True"
                          Width="115" />
      <DataGridTextColumn x:Name="StatusColumn"
                          Header="Status"
                          Binding="{Binding StatusSummary}"
                          IsReadOnly="True"
                          Width="175" />
      <DataGridTextColumn x:Name="DevicesColumn"
                          Header="Devices"
                          Binding="{Binding DeviceCount}"
                          IsReadOnly="True"
                          Width="75" />
    </DataGrid.Columns>

    <!-- Nested Applicable Devices Table -->
    <DataGrid.RowDetailsTemplate>
      <DataTemplate>
        <Border Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource AppBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrushSubtle}"
                BorderThickness="0,1,0,1"
                Padding="36,8,14,10">
          <DataGrid ItemsSource="{Binding Children}"
                    Style="{DynamicResource OpenRctDataGrid}"
                    IsReadOnly="False"
                    RowHeight="26"
                    MaxHeight="280"
                    SelectionMode="Extended"
                    PreviewMouseWheel="ChildGrid_PreviewMouseWheel">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="34" CanUserResize="False" CanUserSort="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Device Name"
                                  Binding="{Binding DeviceName}"
                                  IsReadOnly="True"
                                  Width="175" />
              <DataGridTextColumn Header="{Binding Data.ChildStatusHeader, Source={StaticResource GridProxy}}"
                                  Binding="{Binding Status}"
                                  IsReadOnly="True"
                                  Width="145" />
              <DataGridTextColumn Header="{Binding Data.ChildSecondaryHeader, Source={StaticResource GridProxy}}"
                                  Binding="{Binding SecondaryDetail}"
                                  IsReadOnly="True"
                                  Width="*" />
              <DataGridTextColumn Header="{Binding Data.ChildTimestampHeader, Source={StaticResource GridProxy}}"
                                  Binding="{Binding TimestampDisplay}"
                                  Visibility="{Binding Data.ChildTimestampVisibility, Source={StaticResource GridProxy}}"
                                  IsReadOnly="True"
                                  Width="135" />
              <DataGridTextColumn Header="{Binding Data.ChildErrorHeader, Source={StaticResource GridProxy}}"
                                  Binding="{Binding ErrorCode}"
                                  Visibility="{Binding Data.ChildErrorVisibility, Source={StaticResource GridProxy}}"
                                  IsReadOnly="True"
                                  Width="95" />
            </DataGrid.Columns>
          </DataGrid>
        </Border>
      </DataTemplate>
    </DataGrid.RowDetailsTemplate>
  </DataGrid>
</UserControl>
