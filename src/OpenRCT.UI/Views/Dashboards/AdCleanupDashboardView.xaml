<UserControl x:Class="OpenRCT.UI.Views.Dashboards.AdCleanupDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OpenRCT.UI.Controls"
             Background="{DynamicResource AppBackgroundBrush}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="240" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Title + Pop-Out Button -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
      <TextBlock Text="Active Directory Cleanup Tool"
                 FontSize="24"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource PrimaryTextBrush}"
                 VerticalAlignment="Center" />
      <Button x:Name="PopOutButton"
              Content="↗"
              ToolTip="Open in separate window"
              Margin="10,0,0,0"
              Padding="7,2"
              Style="{StaticResource StandardButton}"
              Click="PopOut_Click" />
    </StackPanel>

    <!-- OUs & Collections Selectors + Scan Button (matches image.png) -->
    <Grid Grid.Row="1" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="90" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="95" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="6" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0" Text="OUs:" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
      <controls:MultiSelectDropdown x:Name="OuDropdown" Grid.Row="0" Grid.Column="1" />

      <TextBlock Grid.Row="2" Grid.Column="0" Text="Collections:" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
      <controls:MultiSelectDropdown x:Name="CollectionDropdown" Grid.Row="2" Grid.Column="1" />

      <Button x:Name="ScanButton"
              Grid.Row="0" Grid.RowSpan="3" Grid.Column="2"
              Content="Scan"
              Margin="10,0,0,0"
              Style="{StaticResource PrimaryButton}"
              Click="Scan_Click" />
    </Grid>

    <!-- Center Interactive Pie Chart (ConfigMgr / Both / Active Directory) -->
    <Border Grid.Row="2"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrushSubtle}"
            BorderThickness="1"
            Margin="0,0,0,10"
            Padding="8">
      <controls:InteractivePieChart x:Name="PresencePieChart" SliceClicked="PresencePieChart_SliceClicked" />
    </Border>

    <!-- 15-Column Results DataGrid (matches image.png exact columns) -->
    <DataGrid x:Name="ResultsGrid"
              Grid.Row="3"
              Style="{StaticResource OpenRctDataGrid}"
              Margin="0,0,0,8">
      <DataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Delete Selected from Active Directory" Click="DeleteFromAd_Click" />
          <MenuItem Header="Delete Selected from ConfigMgr" Click="DeleteFromConfigMgr_Click" />
          <Separator />
          <MenuItem Header="Ping System(s)" Click="PingSelected_Click" />
          <MenuItem Header="Open System Information" Click="SystemInfoSelected_Click" />
        </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="130" />
        <DataGridTextColumn Header="AD Distinguished Name" Binding="{Binding AdDistinguishedName}" Width="200" />
        <DataGridTextColumn Header="AD Password Last Set" Binding="{Binding AdPasswordLastSet, StringFormat=yyyy-MM-dd HH:mm}" Width="130" />
        <DataGridTextColumn Header="AD OS" Binding="{Binding AdOs}" Width="150" />
        <DataGridTextColumn Header="AD OS Version" Binding="{Binding AdOsVersion}" Width="105" />
        <DataGridTextColumn Header="AD Created" Binding="{Binding AdCreated, StringFormat=yyyy-MM-dd}" Width="95" />
        <DataGridTextColumn Header="AD Last Logon Timestamp" Binding="{Binding AdLastLogonTimestamp, StringFormat=yyyy-MM-dd HH:mm}" Width="140" />
        <DataGridTextColumn Header="SCCM Operating System" Binding="{Binding SccmOperatingSystem}" Width="160" />
        <DataGridTextColumn Header="SCCM Last Logon User" Binding="{Binding SccmLastLogonUser}" Width="130" />
        <DataGridTextColumn Header="SCCM Last Logon Domain" Binding="{Binding SccmLastLogonDomain}" Width="130" />
        <DataGridTextColumn Header="SCCM Last Logon Time" Binding="{Binding SccmLastLogonTime, StringFormat=yyyy-MM-dd HH:mm}" Width="130" />
        <DataGridTextColumn Header="SCCM Domain" Binding="{Binding SccmDomain}" Width="100" />
        <DataGridTextColumn Header="SCCM Distinguished Name" Binding="{Binding SccmDistinguishedName}" Width="180" />
        <DataGridTextColumn Header="SCCM Last Check in Time" Binding="{Binding SccmLastCheckInTime, StringFormat=yyyy-MM-dd HH:mm}" Width="140" />
        <DataGridTextColumn Header="SCCM Client Installed" Binding="{Binding SccmClientInstalled}" Width="125" />
      </DataGrid.Columns>
    </DataGrid>

    <!-- Bottom Bar: Errors Drawer + Export to CSV -->
    <DockPanel Grid.Row="4">
      <Button Content="Export to CSV"
              DockPanel.Dock="Right"
              Style="{StaticResource StandardButton}"
              Click="ExportCsv_Click" />
      <TextBlock x:Name="FilterStatusText"
                 DockPanel.Dock="Right"
                 Margin="0,0,14,0"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource SecondaryTextBrush}" />
      <controls:ErrorDrawerControl x:Name="ErrorDrawer" />
    </DockPanel>
  </Grid>
</UserControl>
