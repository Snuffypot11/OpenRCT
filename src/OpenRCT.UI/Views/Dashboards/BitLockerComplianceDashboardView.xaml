<UserControl x:Class="OpenRCT.UI.Views.Dashboards.BitLockerComplianceDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OpenRCT.UI.Controls"
             Background="{DynamicResource AppBackgroundBrush}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="240" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
      <TextBlock Text="BitLocker Compliance"
                 FontSize="24"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource PrimaryTextBrush}"
                 VerticalAlignment="Center" />
      <Button x:Name="PopOutButton"
              Content="↗"
              ToolTip="Open in separate window"
              Margin="10,0,0,0"
              Padding="7,2"
              Style="{DynamicResource StandardButton}"
              Click="PopOut_Click" />
    </StackPanel>

    <!-- Search By AD OU vs Search By Collection -->
    <Grid Grid.Row="1" Margin="0,0,0,10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="6" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="155" />
        <ColumnDefinition Width="80" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="95" />
      </Grid.ColumnDefinitions>

      <RadioButton x:Name="SearchByOuRadio"
                   Grid.Row="0" Grid.Column="0"
                   Content="Search By AD OU"
                   IsChecked="True"
                   VerticalAlignment="Center"
                   Checked="SearchMode_Changed" />
      <TextBlock Grid.Row="0" Grid.Column="1" Text="OUs:" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
      <controls:MultiSelectDropdown x:Name="OuDropdown" Grid.Row="0" Grid.Column="2" />

      <RadioButton x:Name="SearchByCollectionRadio"
                   Grid.Row="2" Grid.Column="0"
                   Content="Search By Collection"
                   VerticalAlignment="Center"
                   Checked="SearchMode_Changed" />
      <TextBlock Grid.Row="2" Grid.Column="1" Text="Collections:" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
      <controls:MultiSelectDropdown x:Name="CollectionDropdown" Grid.Row="2" Grid.Column="2" IsEnabled="False" />

      <Button x:Name="ScanButton"
              Grid.Row="0" Grid.RowSpan="3" Grid.Column="3"
              Content="Scan"
              Margin="10,0,0,0"
              VerticalAlignment="Bottom"
              Style="{DynamicResource PrimaryButton}"
              Click="Scan_Click" />
    </Grid>

    <!-- Two Side-by-Side Pie Charts -->
    <Grid Grid.Row="2" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="1" Padding="8">
        <controls:InteractivePieChart x:Name="KeyStorageChart" ChartTitle="BitLocker Recovery Key Storage" SliceClicked="KeyStorageChart_SliceClicked" />
      </Border>

      <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="1" Padding="8">
        <controls:InteractivePieChart x:Name="ComplianceChart" ChartTitle="Unified Compliance" SliceClicked="ComplianceChart_SliceClicked" />
      </Border>
    </Grid>

    <!-- Device Results DataGrid -->
    <DataGrid x:Name="ResultsGrid" Grid.Row="3" Style="{DynamicResource OpenRctDataGrid}" Margin="0,0,0,8">
      <DataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="View BitLocker Recovery Key" Click="ViewBitLockerKey_Click" />
          <MenuItem Header="System Information" Click="SystemInfo_Click" />
          <MenuItem Header="Client Information" Click="ClientInfo_Click" />
          <Separator />
          <MenuItem Header="Machine Policy Retrieval &amp; Evaluation" Click="MachinePolicy_Click" />
          <MenuItem Header="Ping System(s)" Click="PingSystems_Click" />
        </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="145" />
        <DataGridTextColumn Header="Key Storage" Binding="{Binding KeyStorage}" Width="90" />
        <DataGridTextColumn Header="Unified Compliance" Binding="{Binding UnifiedCompliance}" Width="140" />
        <DataGridTextColumn Header="CM BitLocker Compliance" Binding="{Binding CmBitLockerCompliance}" Width="150" />
        <DataGridTextColumn Header="Encryption Method" Binding="{Binding EncryptionMethod}" Width="135" />
        <DataGridTextColumn Header="Protection Status" Binding="{Binding ProtectionStatus}" Width="115" />
        <DataGridTextColumn Header="Distinguished Name" Binding="{Binding DistinguishedName}" Width="240" />
        <DataGridTextColumn Header="Password Last Set" Binding="{Binding PasswordLastSet, StringFormat=yyyy-MM-dd HH:mm}" Width="130" />
        <DataGridTextColumn Header="OS" Binding="{Binding OperatingSystem}" Width="165" />
        <DataGridTextColumn Header="OS Version" Binding="{Binding OperatingSystemVersion}" Width="105" />
      </DataGrid.Columns>
    </DataGrid>

    <DockPanel Grid.Row="4">
      <Button Content="Export to CSV" DockPanel.Dock="Right" Style="{DynamicResource StandardButton}" Click="ExportCsv_Click" />
      <TextBlock x:Name="FilterStatusText" DockPanel.Dock="Right" Margin="0,0,14,0" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
      <controls:ErrorDrawerControl x:Name="ErrorDrawer" />
    </DockPanel>
  </Grid>
</UserControl>
