<UserControl x:Class="OpenRCT.UI.Views.Dashboards.LapsDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OpenRCT.UI.Controls"
             Background="{DynamicResource AppBackgroundBrush}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="240" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
      <TextBlock Text="LAPS Dashboard"
                 FontSize="24"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource PrimaryTextBrush}"
                 VerticalAlignment="Center" />
      <Button x:Name="PopOutButton"
              Content="↗"
              ToolTip="Open in separate window"
              Margin="10,0,0,0"
              Padding="7,2"
              Style="{StaticResource StandardButton}"
              Click="PopOut_Click" />
    </StackPanel>

    <!-- OU Selector + Scan Button (matches image_2.png) -->
    <Grid Grid.Row="1" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="50" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="95" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="OUs:" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
      <controls:MultiSelectDropdown x:Name="OuDropdown" Grid.Column="1" />
      <Button x:Name="ScanButton" Grid.Column="2" Content="Scan" Margin="10,0,0,0" Style="{StaticResource PrimaryButton}" Click="Scan_Click" />
    </Grid>

    <!-- Two Side-by-Side Pie Charts matching image_2.png -->
    <Grid Grid.Row="2" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="1" Padding="8">
        <controls:InteractivePieChart x:Name="PasswordChart" ChartTitle="LAPS Password in AD" SliceClicked="PasswordChart_SliceClicked" />
      </Border>

      <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="1" Padding="8">
        <controls:InteractivePieChart x:Name="ClientStateChart" ChartTitle="LAPS Client Install State" SliceClicked="ClientStateChart_SliceClicked" />
      </Border>
    </Grid>

    <!-- 8-Column DataGrid matching image_2.png -->
    <DataGrid x:Name="ResultsGrid" Grid.Row="3" Style="{StaticResource OpenRctDataGrid}" Margin="0,0,0,8">
      <DataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="View LAPS Password" Click="ViewLapsPassword_Click" />
          <MenuItem Header="Open System Information" Click="SystemInfo_Click" />
        </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="140" />
        <DataGridTextColumn Header="Distinguished Name" Binding="{Binding DistinguishedName}" Width="240" />
        <DataGridTextColumn Header="Password Last Set" Binding="{Binding PasswordLastSet, StringFormat=yyyy-MM-dd HH:mm}" Width="135" />
        <DataGridTextColumn Header="OS" Binding="{Binding Os}" Width="170" />
        <DataGridTextColumn Header="OS Version" Binding="{Binding OsVersion}" Width="110" />
        <DataGridTextColumn Header="LAPS Password Expiration" Binding="{Binding LapsPasswordExpiration, StringFormat=yyyy-MM-dd HH:mm}" Width="155" />
        <DataGridTextColumn Header="Laps Client Install State" Binding="{Binding ClientInstallStateLabel}" Width="175" />
        <DataGridTextColumn Header="Created" Binding="{Binding Created, StringFormat=yyyy-MM-dd}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>

    <DockPanel Grid.Row="4">
      <Button Content="Export to CSV" DockPanel.Dock="Right" Style="{StaticResource StandardButton}" Click="ExportCsv_Click" />
      <TextBlock x:Name="FilterStatusText" DockPanel.Dock="Right" Margin="0,0,14,0" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
      <controls:ErrorDrawerControl x:Name="ErrorDrawer" />
    </DockPanel>
  </Grid>
</UserControl>
