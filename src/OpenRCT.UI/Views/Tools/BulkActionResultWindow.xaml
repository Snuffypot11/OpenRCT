<Window x:Class="OpenRCT.UI.Views.Tools.BulkActionResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpenRCT.UI.Controls"
        Width="860" Height="540"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,10">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="RetryFailedButton" Content="Retry Failed" Style="{StaticResource StandardButton}" Margin="0,0,6,0" IsEnabled="False" Click="RetryFailed_Click" />
        <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource DangerButton}" Click="Cancel_Click" />
      </StackPanel>
      <StackPanel>
        <TextBlock x:Name="HeaderTitleText" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
        <TextBlock x:Name="SummaryStatsText" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0" />
      </StackPanel>
    </DockPanel>

    <ProgressBar x:Name="ProgressBar" Grid.Row="1" Height="6" Margin="0,0,0,10" Minimum="0" Maximum="100" />

    <DataGrid x:Name="ResultsGrid" Grid.Row="2" Style="{StaticResource OpenRctDataGrid}" Margin="0,0,0,8">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="165" />
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="95" />
        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
        <DataGridTextColumn Header="Duration (ms)" Binding="{Binding Duration.TotalMilliseconds, StringFormat=0}" Width="95" />
      </DataGrid.Columns>
    </DataGrid>

    <DockPanel Grid.Row="3">
      <Button Content="Export to CSV" DockPanel.Dock="Right" Style="{StaticResource StandardButton}" Click="ExportCsv_Click" />
      <controls:ErrorDrawerControl x:Name="ErrorDrawer" />
    </DockPanel>
  </Grid>
</Window>
