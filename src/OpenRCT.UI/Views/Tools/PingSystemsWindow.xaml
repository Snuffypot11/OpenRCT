<Window x:Class="OpenRCT.UI.Views.Tools.PingSystemsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ping System(s)"
        Width="780" Height="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,10">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <CheckBox x:Name="ContinuousCheck" Content="Continuous" VerticalAlignment="Center" Margin="0,0,12,0" />
        <Button x:Name="PingButton" Content="Ping Now" Style="{DynamicResource PrimaryButton}" Margin="0,0,6,0" Click="Ping_Click" />
        <Button x:Name="StopButton" Content="Stop" Style="{DynamicResource StandardButton}" IsEnabled="False" Click="Stop_Click" />
      </StackPanel>
      <TextBlock x:Name="SummaryText" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
    </DockPanel>

    <DataGrid x:Name="PingGrid" Grid.Row="1" Style="{DynamicResource OpenRctDataGrid}" Margin="0,0,0,8">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="160" />
        <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="125" />
        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="170" />
        <DataGridTextColumn Header="Sent" Binding="{Binding SentCount}" Width="60" />
        <DataGridTextColumn Header="Succeeded" Binding="{Binding SuccessCount}" Width="80" />
        <DataGridTextColumn Header="Last Checked" Binding="{Binding LastChecked, StringFormat=HH:mm:ss}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>

    <Button Grid.Row="2" Content="Export to CSV" HorizontalAlignment="Right" Style="{DynamicResource StandardButton}" Click="ExportCsv_Click" />
  </Grid>
</Window>
