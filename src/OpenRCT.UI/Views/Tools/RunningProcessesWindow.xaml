<Window x:Class="OpenRCT.UI.Views.Tools.RunningProcessesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpenRCT.UI.Controls"
        Title="Running Processes"
        Width="960" Height="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,10">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Terminate Selected" Style="{StaticResource DangerButton}" Margin="0,0,6,0" Click="Terminate_Click" />
        <Button Content="Refresh" Style="{StaticResource StandardButton}" Click="Refresh_Click" />
      </StackPanel>
      <TextBox x:Name="FilterBox" Padding="6,4" Margin="0,0,10,0" TextChanged="FilterBox_TextChanged" />
    </DockPanel>

    <DataGrid x:Name="ProcessGrid" Grid.Row="1" Style="{StaticResource OpenRctDataGrid}" Margin="0,0,0,8">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="140" />
        <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="70" />
        <DataGridTextColumn Header="Process Name" Binding="{Binding Name}" Width="180" />
        <DataGridTextColumn Header="Memory (MB)" Binding="{Binding WorkingSetMb}" Width="95" />
        <DataGridTextColumn Header="Started" Binding="{Binding CreationDate, StringFormat=yyyy-MM-dd HH:mm}" Width="130" />
        <DataGridTextColumn Header="Command Line" Binding="{Binding CommandLine}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>

    <controls:ErrorDrawerControl x:Name="ErrorDrawer" Grid.Row="2" />
  </Grid>
</Window>
