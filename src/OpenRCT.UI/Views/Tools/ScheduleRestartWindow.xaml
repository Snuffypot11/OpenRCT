<Window x:Class="OpenRCT.UI.Views.Tools.ScheduleRestartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Schedule Restart or Shutdown"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
  <StackPanel Margin="16">
    <TextBlock x:Name="TargetSummaryText" FontWeight="SemiBold" Margin="0,0,0,12" />

    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
      <RadioButton x:Name="RestartRadio" Content="Restart System(s)" IsChecked="True" Margin="0,0,20,0" />
      <RadioButton x:Name="ShutdownRadio" Content="Shutdown System(s)" />
    </StackPanel>

    <DockPanel Margin="0,0,0,10">
      <TextBlock Text="Delay countdown (seconds):" Width="175" VerticalAlignment="Center" />
      <TextBox x:Name="DelayBox" Text="300" Width="100" HorizontalAlignment="Left" Padding="6,4" />
    </DockPanel>

    <CheckBox x:Name="ForceCheck" Content="Force running applications to close (/f)" IsChecked="True" Margin="0,3" />
    <CheckBox x:Name="SkipLoggedOnCheck" Content="Skip device if a user is currently logged on" Margin="0,3,0,10" />

    <TextBlock Text="User countdown message:" Margin="0,0,0,4" />
    <TextBox x:Name="MessageBoxInput" Text="Your IT administrator has scheduled a system restart. Please save your work." Height="70" TextWrapping="Wrap" Padding="6" Margin="0,0,0,14" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Schedule" Width="95" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}" Click="Schedule_Click" />
      <Button Content="Cancel" Width="90" Style="{StaticResource StandardButton}" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
