<Window x:Class="OpenRCT.UI.Views.Tools.ScheduleRestartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restart / Shutdown System(s)"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
  <StackPanel Margin="16">
    <TextBlock x:Name="TargetSummaryText" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />

    <!-- Action Type -->
    <TextBlock Text="Action:" FontWeight="SemiBold" Margin="0,0,0,4" />
    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
      <RadioButton x:Name="RestartRadio" Content="Restart System(s)" IsChecked="True" Margin="0,0,24,0" Checked="ActionType_Changed" />
      <RadioButton x:Name="ShutdownRadio" Content="Shutdown System(s)" Checked="ActionType_Changed" />
    </StackPanel>

    <!-- Timing Options -->
    <TextBlock Text="Timing:" FontWeight="SemiBold" Margin="0,0,0,4" />
    <StackPanel Margin="0,0,0,12">
      <RadioButton x:Name="CountdownRadio" Content="Countdown delay (seconds):" IsChecked="True" Margin="0,2" Checked="TimingMode_Changed" />
      <StackPanel Orientation="Horizontal" Margin="20,4,0,6">
        <TextBox x:Name="DelayBox" Text="60" Width="90" Padding="6,4" />
        <Button Content="Now (0s)" Style="{DynamicResource StandardButton}" Margin="8,0,0,0" Padding="8,2" Click="Preset0_Click" />
        <Button Content="1 min" Style="{DynamicResource StandardButton}" Margin="4,0,0,0" Padding="8,2" Click="Preset60_Click" />
        <Button Content="5 min" Style="{DynamicResource StandardButton}" Margin="4,0,0,0" Padding="8,2" Click="Preset300_Click" />
        <Button Content="15 min" Style="{DynamicResource StandardButton}" Margin="4,0,0,0" Padding="8,2" Click="Preset900_Click" />
      </StackPanel>

      <RadioButton x:Name="ScheduledTimeRadio" Content="Schedule at specific date &amp; time (local):" Margin="0,2" Checked="TimingMode_Changed" />
      <StackPanel Orientation="Horizontal" Margin="20,4,0,0">
        <DatePicker x:Name="ScheduleDatePicker" Width="140" IsEnabled="False" />
        <TextBlock Text="Time (HH:mm):" VerticalAlignment="Center" Margin="10,0,6,0" />
        <TextBox x:Name="ScheduleTimeBox" Text="22:00" Width="70" Padding="6,4" IsEnabled="False" />
      </StackPanel>
    </StackPanel>

    <!-- Options -->
    <CheckBox x:Name="ForceCheck" Content="Force running applications to close (/f)" IsChecked="True" Margin="0,3" />
    <CheckBox x:Name="SkipLoggedOnCheck" Content="Skip device if a user is currently logged on" Margin="0,3,0,10" />

    <!-- User Notice -->
    <CheckBox x:Name="IncludeNoticeCheck" Content="Display notice to logged-on user:" IsChecked="True" Margin="0,0,0,6" Checked="NoticeCheck_Changed" Unchecked="NoticeCheck_Changed" />
    <TextBox x:Name="MessageBoxInput"
             Text="Your IT administrator has scheduled a system restart. Please save your work."
             Height="76"
             TextWrapping="Wrap"
             AcceptsReturn="True"
             Padding="6"
             Margin="0,0,0,14" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="ExecuteButton" Content="Restart" Width="105" Margin="0,0,8,0" Style="{DynamicResource PrimaryButton}" Click="Schedule_Click" />
      <Button Content="Cancel" Width="90" Style="{DynamicResource StandardButton}" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
