<Window x:Class="OpenRCT.UI.Views.Tools.RemoteRegistryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpenRCT.UI.Controls"
        Title="Remote Registry Editor"
        Width="1060" Height="640"
        MinWidth="820" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Top Address Bar + Actions -->
    <DockPanel Grid.Row="0" Margin="0,0,0,10">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Go" Style="{DynamicResource PrimaryButton}" Margin="6,0,0,0" Click="GoPath_Click" />
        <Button Content="Refresh" Style="{DynamicResource StandardButton}" Margin="6,0,0,0" Click="Refresh_Click" />
        <Button Content="Start RemoteRegistry Svc" Style="{DynamicResource StandardButton}" Margin="6,0,0,0" Click="StartRemoteRegistryService_Click" />
        <Button Content="Set Value" Style="{DynamicResource StandardButton}" Margin="6,0,0,0" Click="EditValue_Click" />
        <Button Content="Delete Value" Style="{DynamicResource DangerButton}" Margin="6,0,0,0" Click="DeleteValue_Click" />
      </StackPanel>
      <ComboBox x:Name="DeviceCombo" Width="190" DisplayMemberPath="DisplayName" Margin="0,0,8,0" SelectionChanged="DeviceCombo_SelectionChanged" />
      <TextBox x:Name="PathBox" Padding="6,4" VerticalContentAlignment="Center" />
    </DockPanel>

    <!-- Left Key Tree + Right Values Grid -->
    <Grid Grid.Row="1" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320" MinWidth="200" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="1">
        <TreeView x:Name="RegTree"
                  Background="Transparent"
                  BorderThickness="0"
                  Foreground="{DynamicResource PrimaryTextBrush}"
                  SelectedItemChanged="RegTree_SelectedItemChanged" />
      </Border>

      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

      <DataGrid x:Name="ValuesGrid" Grid.Column="2" Style="{DynamicResource OpenRctDataGrid}" SelectionMode="Single">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="210" />
          <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="110" />
          <DataGridTextColumn Header="Data" Binding="{Binding Data}" Width="*" MinWidth="200" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>

    <DockPanel Grid.Row="2">
      <TextBlock x:Name="StatusText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
      <controls:ErrorDrawerControl x:Name="ErrorDrawer" />
    </DockPanel>
  </Grid>
</Window>
