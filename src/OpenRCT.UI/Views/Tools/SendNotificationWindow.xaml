<Window x:Class="OpenRCT.UI.Views.Tools.SendNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Send Notification"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
  <StackPanel Margin="16">
    <TextBlock x:Name="TargetSummaryText" FontWeight="SemiBold" Margin="0,0,0,10" />
    <TextBlock Text="Message to display to logged-on users:" Margin="0,0,0,4" />
    <TextBox x:Name="MessageBoxInput" Height="110" TextWrapping="Wrap" AcceptsReturn="True" Padding="6" Margin="0,0,0,10" />
    <DockPanel Margin="0,0,0,14">
      <TextBlock Text="Display timeout (seconds):" Width="170" VerticalAlignment="Center" />
      <TextBox x:Name="DurationBox" Text="300" Width="90" HorizontalAlignment="Left" Padding="6,4" />
    </DockPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Send" Width="90" Margin="0,0,8,0" Style="{DynamicResource PrimaryButton}" Click="Send_Click" />
      <Button Content="Cancel" Width="90" Style="{DynamicResource StandardButton}" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
