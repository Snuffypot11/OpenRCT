<Window x:Class="OpenRCT.UI.Views.Tools.BitLockerKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpenRCT.UI.Controls"
        Title="BitLocker Recovery Keys"
        Width="920" Height="460"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,10">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Copy Selected Recovery Key" Style="{DynamicResource PrimaryButton}" Margin="0,0,6,0" Click="CopyKey_Click" />
        <Button Content="Refresh" Style="{DynamicResource StandardButton}" Click="Refresh_Click" />
      </StackPanel>
      <TextBlock Text="BitLocker Recovery Keys (Active Directory &amp; ConfigMgr)" FontWeight="SemiBold" VerticalAlignment="Center" />
    </DockPanel>

    <DataGrid x:Name="KeysGrid" Grid.Row="1" Style="{DynamicResource OpenRctDataGrid}" Margin="0,0,0,8">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="135" />
        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="115" />
        <DataGridTextColumn Header="Recovery Key ID" Binding="{Binding RecoveryKeyId}" Width="210" />
        <DataGridTextColumn Header="Recovery Password" Binding="{Binding RecoveryPassword}" Width="300" />
        <DataGridTextColumn Header="Created (UTC)" Binding="{Binding CreatedUtc, StringFormat=yyyy-MM-dd HH:mm}" Width="*" MinWidth="135" />
      </DataGrid.Columns>
    </DataGrid>

    <controls:ErrorDrawerControl x:Name="ErrorDrawer" Grid.Row="2" />
  </Grid>
</Window>
