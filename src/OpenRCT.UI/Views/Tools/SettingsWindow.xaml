<Window x:Class="OpenRCT.UI.Views.Tools.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenRCT Settings"
        Width="660" Height="560"
        MinWidth="580" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Save" Width="90" Margin="0,0,8,0" Style="{DynamicResource PrimaryButton}" Click="Save_Click" />
      <Button Content="Cancel" Width="90" Style="{DynamicResource StandardButton}" IsCancel="True" />
    </StackPanel>

    <TabControl Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}">
      <!-- Tab 1: External Tools (Optional PsExec) -->
      <TabItem Header="External Tools (PsExec)">
        <StackPanel Margin="16">
          <TextBlock Text="Optional External Tool — Sysinternals PsExec" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
          <TextBlock Text="OpenRCT has zero mandatory external dependencies. PsExec is only required if you want to use Console Tools → Interactive Command Prompt."
                     TextWrapping="Wrap" Margin="0,6,0,14" Foreground="{DynamicResource SecondaryTextBrush}" />

          <TextBlock Text="Path to PsExec.exe or PsExec64.exe:" Margin="0,0,0,4" />
          <DockPanel Margin="0,0,0,6">
            <Button Content="Browse..." DockPanel.Dock="Right" Margin="8,0,0,0" Style="{DynamicResource StandardButton}" Click="BrowsePsExec_Click" />
            <TextBox x:Name="PsExecPathBox" Padding="6,4" TextChanged="PsExecPathBox_TextChanged" />
          </DockPanel>
          <TextBlock x:Name="PsExecStatusText" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14" />

          <CheckBox x:Name="PsExecSystemCheck" Content="Run Interactive Command Prompt as Local SYSTEM (-s)" Margin="0,4" />
          <CheckBox x:Name="PsExecEulaCheck" Content="Automatically pass -accepteula" Margin="0,4" />

          <TextBlock Text="Additional PsExec Arguments (optional):" Margin="0,12,0,4" />
          <TextBox x:Name="PsExecArgsBox" Padding="6,4" />
        </StackPanel>
      </TabItem>

      <!-- Tab 2: Connections & Concurrency -->
      <TabItem Header="Connections &amp; Performance">
        <StackPanel Margin="16">
          <TextBlock Text="Remote Management &amp; Bulk Execution" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,12" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="220" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="10" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="10" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="10" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="10" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="12" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="10" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Preferred Remote Transport:" VerticalAlignment="Center" />
            <ComboBox x:Name="TransportCombo" Grid.Row="0" Grid.Column="1" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Connection Timeout (seconds):" VerticalAlignment="Center" />
            <TextBox x:Name="TimeoutBox" Grid.Row="2" Grid.Column="1" Padding="6,4" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Max Concurrent Devices (1–64):" VerticalAlignment="Center" />
            <TextBox x:Name="ConcurrencyBox" Grid.Row="4" Grid.Column="1" Padding="6,4" />

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Default SMS Provider Server (optional):" VerticalAlignment="Center" />
            <TextBox x:Name="SmsServerBox" Grid.Row="6" Grid.Column="1" Padding="6,4" />

            <TextBlock Grid.Row="8" Grid.Column="0" Text="Default Site Code (optional):" VerticalAlignment="Center" />
            <TextBox x:Name="SiteCodeBox" Grid.Row="8" Grid.Column="1" Padding="6,4" MaxLength="3" />

            <CheckBox x:Name="FastOfflineCheckBox"
                      Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2"
                      Content="Fast offline pre-check before querying remote devices (ICMP Ping + RPC/SMB probe)" />

            <TextBlock Grid.Row="12" Grid.Column="0" Text="Offline Check Timeout (ms):" VerticalAlignment="Center" />
            <TextBox x:Name="OfflineTimeoutMsBox" Grid.Row="12" Grid.Column="1" Padding="6,4" />
          </Grid>
        </StackPanel>
      </TabItem>

      <!-- Tab 3: Appearance & Security -->
      <TabItem Header="Appearance &amp; Security">
        <StackPanel Margin="16">
          <TextBlock Text="Theme &amp; Safety Preferences" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,12" />

          <DockPanel Margin="0,0,0,10">
            <TextBlock Text="UI Theme:" Width="160" VerticalAlignment="Center" />
            <ComboBox x:Name="ThemeCombo" />
          </DockPanel>

          <DockPanel Margin="0,0,0,6">
            <TextBlock Text="Icon Style:" Width="160" VerticalAlignment="Center" />
            <Button Content="Apply to MECM Console" DockPanel.Dock="Right" Margin="8,0,0,0"
                    Style="{DynamicResource StandardButton}" Click="ApplyConsoleIcons_Click" />
            <ComboBox x:Name="IconStyleCombo" />
          </DockPanel>
          <TextBlock x:Name="IconStyleStatusText"
                     Text="Changes apply immediately to OpenRCT windows. MECM Console tree and right-click icons update after restarting the console."
                     FontSize="12" TextWrapping="Wrap" Margin="160,0,0,14"
                     Foreground="{DynamicResource SecondaryTextBrush}" />

          <CheckBox x:Name="ConfirmDestructiveCheck" Content="Prompt for confirmation before destructive actions (Delete, Uninstall, Restart/Shutdown)" Margin="0,6" />
          <CheckBox x:Name="AutoClearClipboardCheck" Content="Automatically clear clipboard after copying LAPS passwords or BitLocker recovery keys" Margin="0,6" />

          <DockPanel Margin="0,10,0,0">
            <TextBlock Text="Clear clipboard after (seconds):" Width="210" VerticalAlignment="Center" />
            <TextBox x:Name="ClipboardSecondsBox" Width="90" HorizontalAlignment="Left" Padding="6,4" />
          </DockPanel>
        </StackPanel>
      </TabItem>

      <!-- Tab 4: Updates (Fork-Friendly GitHub Release Source) -->
      <TabItem Header="Updates">
        <StackPanel Margin="16">
          <TextBlock Text="Release Update Checks (Optional &amp; Manual)" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
          <TextBlock Text="OpenRCT never phones home automatically in the background. When you click Check for Updates, it queries the GitHub Releases API for the repository below and opens the release page in your browser."
                     TextWrapping="Wrap" Margin="0,6,0,14" Foreground="{DynamicResource SecondaryTextBrush}" />

          <CheckBox x:Name="EnableUpdateChecksCheck" Content="Enable manual 'Check for Updates' button (uncheck for air-gapped environments)" Margin="0,0,0,12" />

          <TextBlock Text="GitHub Repository Override (owner/repo or full GitHub URL; leave blank to use build default):" Margin="0,0,0,4" TextWrapping="Wrap" />
          <TextBox x:Name="UpdateRepoBox" Padding="6,4" TextChanged="UpdateRepoBox_TextChanged" />
          <TextBlock x:Name="UpdateRepoStatusText" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,14" Foreground="{DynamicResource SecondaryTextBrush}" />

          <StackPanel Orientation="Horizontal">
            <Button Content="Check for Updates Now" Style="{DynamicResource StandardButton}" Click="CheckUpdatesNow_Click" />
            <TextBlock x:Name="InstalledVersionText" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
          </StackPanel>
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
