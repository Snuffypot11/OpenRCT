<Window x:Class="OpenRCT.UI.Views.Tools.AddToCollectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Device(s) to Collection"
        Width="600" Height="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="HeaderText" Grid.Row="0" FontWeight="SemiBold" Margin="0,0,0,8" />
    <TextBox x:Name="SearchBox" Grid.Row="1" Padding="6,4" Margin="0,0,0,8" TextChanged="SearchBox_TextChanged" />

    <DataGrid x:Name="CollectionsGrid" Grid.Row="2" Style="{DynamicResource OpenRctDataGrid}" SelectionMode="Single" Margin="0,0,0,10">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Collection ID" Binding="{Binding CollectionId}" Width="105" />
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
        <DataGridTextColumn Header="Members" Binding="{Binding MemberCount}" Width="80" />
      </DataGrid.Columns>
    </DataGrid>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="AddButton" Content="Add Selected Device(s)" Style="{DynamicResource PrimaryButton}" Margin="0,0,8,0" Click="Add_Click" />
      <Button Content="Cancel" Width="90" Style="{DynamicResource StandardButton}" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
