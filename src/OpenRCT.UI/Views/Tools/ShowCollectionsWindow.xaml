<Window x:Class="OpenRCT.UI.Views.Tools.ShowCollectionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpenRCT.UI.Controls"
        Title="Show Collections - Advanced"
        Width="960" Height="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,10">
      <Button Content="Refresh" DockPanel.Dock="Right" Style="{DynamicResource StandardButton}" Click="Refresh_Click" />
      <TextBox x:Name="FilterBox" Padding="6,4" Margin="0,0,10,0" TextChanged="FilterBox_TextChanged" />
    </DockPanel>

    <TabControl Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" Margin="0,0,0,8">
      <TabItem Header="Collections">
        <DataGrid x:Name="CollectionsGrid" Style="{DynamicResource OpenRctDataGrid}" Margin="8">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="140" />
            <DataGridTextColumn Header="Collection ID" Binding="{Binding CollectionId}" Width="105" />
            <DataGridTextColumn Header="Collection Name" Binding="{Binding CollectionName}" Width="260" />
            <DataGridTextColumn Header="Membership" Binding="{Binding MembershipType}" Width="115" />
            <DataGridTextColumn Header="Members" Binding="{Binding MemberCount}" Width="80" />
            <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="*" MinWidth="200" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="Maintenance Windows">
        <DataGrid x:Name="MaintenanceWindowsGrid" Style="{DynamicResource OpenRctDataGrid}" Margin="8">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Collection" Binding="{Binding CollectionName}" Width="200" />
            <DataGridTextColumn Header="Window Name" Binding="{Binding Name}" Width="180" />
            <DataGridTextColumn Header="Type" Binding="{Binding ServiceWindowType}" Width="130" />
            <DataGridTextColumn Header="Enabled" Binding="{Binding IsEnabled}" Width="75" />
            <DataGridTextColumn Header="Duration (min)" Binding="{Binding DurationMinutes}" Width="105" />
            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" MinWidth="200" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
    </TabControl>

    <controls:ErrorDrawerControl x:Name="ErrorDrawer" Grid.Row="2" />
  </Grid>
</Window>
