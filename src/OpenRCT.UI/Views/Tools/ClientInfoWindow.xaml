<Window x:Class="OpenRCT.UI.Views.Tools.ClientInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpenRCT.UI.Controls"
        Title="Client Information"
        Width="900" Height="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,10">
      <Button Content="Refresh" DockPanel.Dock="Right" Style="{StaticResource StandardButton}" Click="Refresh_Click" />
      <ComboBox x:Name="DeviceCombo" Width="240" DisplayMemberPath="DisplayName" HorizontalAlignment="Left" SelectionChanged="DeviceCombo_SelectionChanged" />
    </DockPanel>

    <TabControl Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" Margin="0,0,0,8">
      <TabItem Header="Client Details">
        <Grid Margin="14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="28" /><RowDefinition Height="28" /><RowDefinition Height="28" />
            <RowDefinition Height="28" /><RowDefinition Height="28" /><RowDefinition Height="28" /><RowDefinition Height="28" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Client Version:" FontWeight="SemiBold" />
          <TextBlock x:Name="VersionText" Grid.Row="0" Grid.Column="1" />
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Assigned Site Code:" FontWeight="SemiBold" />
          <TextBlock x:Name="SiteCodeText" Grid.Row="1" Grid.Column="1" />
          <TextBlock Grid.Row="2" Grid.Column="0" Text="Management Point:" FontWeight="SemiBold" />
          <TextBlock x:Name="MpText" Grid.Row="2" Grid.Column="1" />
          <TextBlock Grid.Row="3" Grid.Column="0" Text="Client GUID:" FontWeight="SemiBold" />
          <TextBlock x:Name="GuidText" Grid.Row="3" Grid.Column="1" />
          <TextBlock Grid.Row="4" Grid.Column="0" Text="SMS Agent Host:" FontWeight="SemiBold" />
          <TextBlock x:Name="ServiceText" Grid.Row="4" Grid.Column="1" />
          <TextBlock Grid.Row="5" Grid.Column="0" Text="Cache Location:" FontWeight="SemiBold" />
          <TextBlock x:Name="CacheLocText" Grid.Row="5" Grid.Column="1" />
          <TextBlock Grid.Row="6" Grid.Column="0" Text="Cache Usage:" FontWeight="SemiBold" />
          <TextBlock x:Name="CacheUsageText" Grid.Row="6" Grid.Column="1" />
        </Grid>
      </TabItem>

      <TabItem Header="Components">
        <DataGrid x:Name="ComponentsGrid" Style="{StaticResource OpenRctDataGrid}" Margin="8">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Component" Binding="{Binding Name}" Width="200" />
            <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="*" />
            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="120" />
            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="90" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>

      <TabItem Header="Cache">
        <DockPanel Margin="8">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
            <Button Content="Delete Selected Cache Item" Style="{StaticResource DangerButton}" Click="DeleteCacheItem_Click" />
          </StackPanel>
          <DataGrid x:Name="CacheGrid" Style="{StaticResource OpenRctDataGrid}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Content ID" Binding="{Binding ContentId}" Width="150" />
              <DataGridTextColumn Header="Ver" Binding="{Binding ContentVersion}" Width="55" />
              <DataGridTextColumn Header="Size (MB)" Binding="{Binding SizeMb}" Width="85" />
              <DataGridTextColumn Header="Last Referenced" Binding="{Binding LastReferenced, StringFormat=yyyy-MM-dd HH:mm}" Width="135" />
              <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
    </TabControl>

    <controls:ErrorDrawerControl x:Name="ErrorDrawer" Grid.Row="2" />
  </Grid>
</Window>
