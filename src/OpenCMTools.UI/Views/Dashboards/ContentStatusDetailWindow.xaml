<Window x:Class="OpenCMTools.UI.Views.Dashboards.ContentStatusDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Content Status"
        Width="860" Height="500"
        MinWidth="680" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="RefreshButton" Content="Refresh" Style="{DynamicResource StandardButton}" Margin="0,0,8,0" Click="Refresh_Click" />
        <Button x:Name="RedistributeButton" Content="Redistribute Selected" Style="{DynamicResource PrimaryButton}" Margin="0,0,8,0" Click="RedistributeSelected_Click" />
        <Button x:Name="ValidateButton" Content="Validate Selected" Style="{DynamicResource StandardButton}" Click="ValidateSelected_Click" />
      </StackPanel>
      <StackPanel>
        <TextBlock x:Name="HeaderTitleText" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
        <TextBlock x:Name="HeaderSubtitleText" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0" />
      </StackPanel>
    </DockPanel>

    <DataGrid x:Name="StatusGrid" Grid.Row="1" Style="{DynamicResource OpenCMToolsDataGrid}" Margin="0,0,0,10">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Distribution Point" Binding="{Binding DistributionPoint}" Width="210" />
        <DataGridTextColumn Header="Site" Binding="{Binding SiteCode}" Width="55" />
        <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="90" />
        <DataGridTextColumn Header="Msg ID" Binding="{Binding MessageId}" Width="65" />
        <DataGridTextColumn Header="Last Update" Binding="{Binding LastUpdateDate, StringFormat=yyyy-MM-dd HH:mm}" Width="125" />
        <DataGridTextColumn Header="Message Summary" Binding="{Binding MessageSummary}" Width="*" MinWidth="200" />
      </DataGrid.Columns>
    </DataGrid>

    <DockPanel Grid.Row="2">
      <Button Content="Close" DockPanel.Dock="Right" Width="85" Style="{DynamicResource StandardButton}" IsCancel="True" />
      <TextBlock x:Name="ActionStatusText" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,12,0" />
    </DockPanel>
  </Grid>
</Window>
