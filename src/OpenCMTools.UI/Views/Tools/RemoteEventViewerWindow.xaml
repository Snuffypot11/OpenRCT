<Window x:Class="OpenCMTools.UI.Views.Tools.RemoteEventViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpenCMTools.UI.Controls"
        Title="Remote Event Viewer"
        Width="1220" Height="740"
        MinWidth="920" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Top Filter Bar (matching Remote Registry style + Event Viewer filter bar) -->
    <Border Grid.Row="0"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrushSubtle}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="10,8"
            Margin="0,0,0,10">
      <StackPanel>
        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Margin="0,2,10,4">
            <TextBlock Text="Device:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold" />
            <ComboBox x:Name="DeviceCombo" Width="175" DisplayMemberPath="DisplayName" SelectionChanged="DeviceCombo_SelectionChanged" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Margin="0,2,10,4">
            <TextBlock Text="Severity:" VerticalAlignment="Center" Margin="0,0,5,0" />
            <ComboBox x:Name="SeverityCombo" Width="125" SelectedIndex="0" SelectionChanged="FilterControl_Changed">
              <ComboBoxItem Content="All" />
              <ComboBoxItem Content="Critical" />
              <ComboBoxItem Content="Error" />
              <ComboBoxItem Content="Critical &amp; Error" />
              <ComboBoxItem Content="Warning" />
              <ComboBoxItem Content="Information" />
              <ComboBoxItem Content="Verbose" />
            </ComboBox>
          </StackPanel>

          <StackPanel Orientation="Horizontal" Margin="0,2,10,4">
            <TextBlock Text="Source:" VerticalAlignment="Center" Margin="0,0,5,0" />
            <TextBox x:Name="SourceBox" Width="165" Padding="5,3" VerticalContentAlignment="Center" ToolTip="Filter by event source/provider name" TextChanged="FilterText_Changed" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Margin="0,2,10,4">
            <TextBlock Text="Event ID:" VerticalAlignment="Center" Margin="0,0,5,0" />
            <TextBox x:Name="EventIdBox" Width="90" Padding="5,3" VerticalContentAlignment="Center" ToolTip="Single ID or comma-separated IDs (e.g. 1000, 7036)" TextChanged="FilterText_Changed" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Margin="0,2,10,4">
            <TextBlock Text="Max Entries:" VerticalAlignment="Center" Margin="0,0,5,0" />
            <TextBox x:Name="MaxEntriesBox" Width="58" Text="200" Padding="5,3" VerticalContentAlignment="Center" TextChanged="FilterText_Changed" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Margin="0,2,10,4">
            <TextBlock Text="Start:" VerticalAlignment="Center" Margin="0,0,5,0" />
            <DatePicker x:Name="StartDatePicker" Width="118" SelectedDateChanged="DatePicker_Changed" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Margin="0,2,10,4">
            <TextBlock Text="End:" VerticalAlignment="Center" Margin="0,0,5,0" />
            <DatePicker x:Name="EndDatePicker" Width="118" SelectedDateChanged="DatePicker_Changed" />
          </StackPanel>
        </WrapPanel>

        <DockPanel Margin="0,4,0,0">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="Clear Filters" Style="{DynamicResource StandardButton}" Margin="6,0,0,0" Click="ClearFilters_Click" />
            <Button Content="Refresh" Style="{DynamicResource PrimaryButton}" Margin="6,0,0,0" Click="Refresh_Click" />
            <Button Content="Export CSV" Style="{DynamicResource StandardButton}" Margin="6,0,0,0" Click="ExportCsv_Click" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Keyword:" VerticalAlignment="Center" Margin="0,0,5,0" />
            <TextBox x:Name="KeywordBox" Width="260" Padding="5,3" VerticalContentAlignment="Center" ToolTip="Filter message text, source, or task category" TextChanged="FilterText_Changed" />
            <TextBlock Text="Filters apply automatically as you type or make a selection."
                       FontStyle="Italic"
                       FontSize="11.5"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
          </StackPanel>
        </DockPanel>
      </StackPanel>
    </Border>

    <!-- Main Split Pane: Left Log Tree + Right Events Table / Pagination / Detail Pane -->
    <Grid Grid.Row="1" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="265" MinWidth="180" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Left Log Tree -->
      <Border Grid.Column="0"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrushSubtle}"
              BorderThickness="1">
        <TreeView x:Name="LogTree"
                  Background="Transparent"
                  BorderThickness="0"
                  Foreground="{DynamicResource PrimaryTextBrush}"
                  SelectedItemChanged="LogTree_SelectedItemChanged" />
      </Border>

      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

      <!-- Right Events Grid + Pagination + Details -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="2*" MinHeight="180" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="6" />
          <RowDefinition Height="*" MinHeight="120" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <DataGrid x:Name="EventsGrid"
                    Style="{DynamicResource OpenCMToolsDataGrid}"
                    CanUserResizeColumns="True"
                    SelectionMode="Single"
                    SelectionChanged="EventsGrid_SelectionChanged">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="95" MinWidth="70" />
              <DataGridTextColumn Header="Time Created" Binding="{Binding TimeCreatedDisplay}" Width="145" MinWidth="115" />
              <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="205" MinWidth="120" />
              <DataGridTextColumn Header="Event ID" Binding="{Binding EventId}" Width="75" MinWidth="60" />
              <DataGridTextColumn Header="Task Category" Binding="{Binding TaskCategory}" Width="120" MinWidth="85" />
              <DataGridTextColumn Header="Message" Binding="{Binding MessagePreview}" Width="*" MinWidth="180" />
            </DataGrid.Columns>
          </DataGrid>

          <Border x:Name="LoadingOverlay"
                  Background="{DynamicResource AppBackgroundBrush}"
                  Opacity="0.88"
                  Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <ProgressBar IsIndeterminate="True" Width="220" Height="6" />
              <TextBlock x:Name="LoadingText" Text="Loading event log..." Margin="0,8,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- Pagination Bar -->
        <DockPanel Grid.Row="1" Margin="0,6,0,4">
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="PrevPageButton" Content="&#x25C2; Previous" Style="{DynamicResource StandardButton}" Padding="10,3" IsEnabled="False" Click="PrevPage_Click" />
            <TextBlock x:Name="PageNumberText" Text="Page 1" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0" />
            <Button x:Name="NextPageButton" Content="Next &#x25B8;" Style="{DynamicResource StandardButton}" Padding="10,3" IsEnabled="False" Click="NextPage_Click" />
            <TextBlock x:Name="PageSummaryText"
                       Margin="14,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
          </StackPanel>
          <Button Content="Copy Event Details"
                  DockPanel.Dock="Right"
                  Style="{DynamicResource StandardButton}"
                  Padding="10,3"
                  Click="CopyDetails_Click" />
        </DockPanel>

        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="Transparent" />

        <!-- Bottom Selected Event Details -->
        <TabControl Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}">
          <TabItem Header="General">
            <TextBox x:Name="EventDetailTextBox"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     BorderThickness="0"
                     Padding="8"
                     FontFamily="Consolas"
                     FontSize="12" />
          </TabItem>
          <TabItem Header="XML View">
            <TextBox x:Name="EventXmlTextBox"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     BorderThickness="0"
                     Padding="8"
                     FontFamily="Consolas"
                     FontSize="11.5" />
          </TabItem>
        </TabControl>
      </Grid>
    </Grid>

    <!-- Bottom Status Bar -->
    <DockPanel Grid.Row="2">
      <TextBlock x:Name="StatusText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
      <controls:ErrorDrawerControl x:Name="ErrorDrawer" />
    </DockPanel>
  </Grid>
</Window>
