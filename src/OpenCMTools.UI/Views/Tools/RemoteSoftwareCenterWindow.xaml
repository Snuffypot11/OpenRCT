<Window x:Class="OpenCMTools.UI.Views.Tools.RemoteSoftwareCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpenCMTools.UI.Controls"
        Title="Remote Software Center"
        Width="1160" Height="680"
        MinWidth="880" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="205" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Left Navigation Rail -->
      <Border Grid.Column="0"
              Background="{DynamicResource SidebarBrush}"
              BorderBrush="{DynamicResource BorderBrushSubtle}"
              BorderThickness="0,0,1,0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="14,12" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="0,0,0,1">
            <StackPanel>
              <TextBlock Text="Software Center" FontSize="14" FontWeight="SemiBold" />
              <TextBlock x:Name="ScopeSubtitleText"
                         Text="Loading targets..."
                         FontSize="11"
                         Margin="0,2,0,0"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
          </Border>

          <ListBox x:Name="NavList"
                   Background="Transparent"
                   BorderThickness="0"
                   SelectedIndex="0"
                   SelectionChanged="NavList_SelectionChanged">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="14,11" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Style.Triggers>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionFillBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SelectionBorderBrush}" />
                    <Setter Property="BorderThickness" Value="3,0,0,0" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBoxItem Tag="Applications">
              <StackPanel Orientation="Horizontal"><controls:VectorIcon IconKey="ToolSoftwareCenter" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" /><TextBlock x:Name="AppsNavText" Text="Applications (0)" VerticalAlignment="Center" /></StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="SoftwareUpdates">
              <StackPanel Orientation="Horizontal"><controls:VectorIcon IconKey="DashSoftwareUpdates" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" /><TextBlock x:Name="UpdatesNavText" Text="Software Updates (0)" VerticalAlignment="Center" /></StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="TaskSequences">
              <StackPanel Orientation="Horizontal"><controls:VectorIcon IconKey="ToolClientAction" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" /><TextBlock x:Name="PackagesNavText" Text="Task Sequences (0)" VerticalAlignment="Center" /></StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Compliance">
              <StackPanel Orientation="Horizontal"><controls:VectorIcon IconKey="ToolDefender" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" /><TextBlock x:Name="ComplianceNavText" Text="Compliance (0)" VerticalAlignment="Center" /></StackPanel>
            </ListBoxItem>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Right Content Area -->
      <Grid Grid.Column="1" Margin="14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Search + Device Filter + Refresh -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <TextBlock Text="Device Filter:" VerticalAlignment="Center" Margin="8,0,6,0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
            <ComboBox x:Name="DeviceFilterCombo"
                      Width="195"
                      DisplayMemberPath="DisplayName"
                      Margin="0,0,8,0"
                      SelectionChanged="DeviceFilterCombo_SelectionChanged" />
            <Button x:Name="RefreshButton"
                    Content="Refresh"
                    Style="{DynamicResource StandardButton}"
                    Click="Refresh_Click" />
          </StackPanel>

          <TextBox x:Name="FilterBox"
                   Padding="8,5"
                   VerticalContentAlignment="Center"
                   ToolTip="Filter by item name, publisher, KB, version, or device name"
                   TextChanged="FilterBox_TextChanged" />
        </DockPanel>

        <!-- Row 1: Contextual Action Bar -->
        <DockPanel Grid.Row="1" Margin="0,0,0,10">
          <TextBlock x:Name="SelectionHintText"
                     DockPanel.Dock="Right"
                     VerticalAlignment="Center"
                     FontSize="11.5"
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     Text="Expand any row to view &amp; select applicable devices" />

          <StackPanel Orientation="Horizontal">
            <!-- Applications actions -->
            <Button x:Name="InstallAppButton" Content="Install" Style="{DynamicResource PrimaryButton}" Margin="0,0,6,0" Click="InstallApp_Click" />
            <Button x:Name="UninstallAppButton" Content="Uninstall" Style="{DynamicResource DangerButton}" Margin="0,0,6,0" Click="UninstallApp_Click" />
            <Button x:Name="RepairAppButton" Content="Repair" Style="{DynamicResource StandardButton}" Margin="0,0,12,0" Click="RepairApp_Click" />
            <Button x:Name="TriggerAppEvalButton" Content="App Deployment Eval" Style="{DynamicResource StandardButton}" Click="TriggerAppEval_Click" />

            <!-- Software Updates actions -->
            <Button x:Name="InstallUpdateButton" Content="Install" Style="{DynamicResource PrimaryButton}" Margin="0,0,6,0" Visibility="Collapsed" Click="InstallUpdate_Click" />
            <Button x:Name="InstallAllUpdatesButton" Content="Install All Pending" Style="{DynamicResource StandardButton}" Margin="0,0,12,0" Visibility="Collapsed" Click="InstallAllUpdates_Click" />
            <Button x:Name="TriggerUpdateScanButton" Content="Update Scan" Style="{DynamicResource StandardButton}" Margin="0,0,6,0" Visibility="Collapsed" Click="TriggerUpdateScan_Click" />
            <Button x:Name="TriggerUpdateEvalButton" Content="Update Eval" Style="{DynamicResource StandardButton}" Visibility="Collapsed" Click="TriggerUpdateEval_Click" />

            <!-- Packages & Task Sequences actions -->
            <Button x:Name="RunPackageButton" Content="Run" Style="{DynamicResource PrimaryButton}" Visibility="Collapsed" Click="RunPackage_Click" />

            <!-- Compliance actions -->
            <Button x:Name="EvaluateBaselineButton" Content="Evaluate" Style="{DynamicResource PrimaryButton}" Visibility="Collapsed" Click="EvaluateBaseline_Click" />
          </StackPanel>
        </DockPanel>

        <!-- Row 2: Expandable Item-First Multi-Device Grid + Loading Overlay -->
        <Grid Grid.Row="2">
          <controls:ExpandableGroupedGridControl x:Name="GroupedGrid" />

          <Border x:Name="LoadingOverlay"
                  Background="{DynamicResource AppBackgroundBrush}"
                  Opacity="0.90"
                  Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <ProgressBar IsIndeterminate="True" Width="240" Height="6" />
              <TextBlock x:Name="LoadingText"
                         Text="Querying Software Center..."
                         Margin="0,8,0,0"
                         HorizontalAlignment="Center"
                         FontWeight="SemiBold" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>

    <!-- Bottom Status Bar -->
    <Border Grid.Row="1"
            Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource BorderBrushSubtle}"
            BorderThickness="0,1,0,0"
            Padding="12,6">
      <DockPanel>
        <Button Content="Export to CSV" DockPanel.Dock="Right" Style="{DynamicResource StandardButton}" Click="ExportCsv_Click" />
        <TextBlock x:Name="StatusText"
                   DockPanel.Dock="Right"
                   Margin="0,0,14,0"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource SecondaryTextBrush}" />
        <controls:ErrorDrawerControl x:Name="ErrorDrawer" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
