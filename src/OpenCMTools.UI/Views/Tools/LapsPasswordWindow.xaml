<Window x:Class="OpenCMTools.UI.Views.Tools.LapsPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpenCMTools.UI.Controls"
        Title="LAPS Password Viewer"
        Width="860" Height="440"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,10">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <CheckBox x:Name="RevealCheck" Content="Reveal Passwords" VerticalAlignment="Center" Margin="0,0,12,0" Checked="Reveal_Changed" Unchecked="Reveal_Changed" />
        <Button Content="Copy Selected Password" Style="{DynamicResource PrimaryButton}" Margin="0,0,6,0" Click="CopyPassword_Click" />
        <Button Content="Refresh" Style="{DynamicResource StandardButton}" Click="Refresh_Click" />
      </StackPanel>
      <TextBlock Text="Local Administrator Password Solution (Legacy &amp; Windows LAPS)" FontWeight="SemiBold" VerticalAlignment="Center" />
    </DockPanel>

    <DataGrid x:Name="LapsGrid" Grid.Row="1" Style="{DynamicResource OpenCMToolsDataGrid}" Margin="0,0,0,8">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="140" />
        <DataGridTextColumn Header="LAPS Type" Binding="{Binding LapsType}" Width="145" />
        <DataGridTextColumn Header="Account" Binding="{Binding AccountName}" Width="130" />
        <DataGridTextColumn Header="Password" Binding="{Binding DisplayPassword}" Width="180" />
        <DataGridTextColumn Header="Expiration" Binding="{Binding ExpirationTime, StringFormat=yyyy-MM-dd HH:mm}" Width="135" />
        <DataGridTextColumn Header="Notes" Binding="{Binding ErrorMessage}" Width="*" MinWidth="200" />
      </DataGrid.Columns>
    </DataGrid>

    <controls:ErrorDrawerControl x:Name="ErrorDrawer" Grid.Row="2" />
  </Grid>
</Window>
