<UserControl x:Class="OpenCMTools.UI.Controls.DistributionStatusBarChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <Button x:Name="ClearSelectionButton"
              DockPanel.Dock="Right"
              Content="Show All DPs"
              Padding="8,2"
              FontSize="11"
              Visibility="Collapsed"
              Style="{DynamicResource StandardButton}"
              Click="ClearSelection_Click" />
      <TextBlock Text="Global Distribution Status"
                 FontSize="13"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource PrimaryTextBrush}"
                 VerticalAlignment="Center" />
    </DockPanel>

    <!-- Legend -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
      <Border Width="11" Height="11" CornerRadius="6" Background="#2196F3" VerticalAlignment="Center" Margin="0,0,5,0" />
      <TextBlock Text="Success" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
      <Border Width="11" Height="11" CornerRadius="6" Background="#F59E0B" VerticalAlignment="Center" Margin="0,0,5,0" />
      <TextBlock Text="In Progress" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
      <Border Width="11" Height="11" CornerRadius="6" Background="#EF4444" VerticalAlignment="Center" Margin="0,0,5,0" />
      <TextBlock Text="Error" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="BarsPanel" Margin="0,2,4,2" />
    </ScrollViewer>
  </DockPanel>
</UserControl>
