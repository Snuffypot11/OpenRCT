<Window x:Class="OpenRCT.App.MainLauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenRCT — Open Source Right Click Tools for MECM"
        Width="980" Height="680"
        MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Non-Overlapping 2-Column Header with Update Check & Vector Cog Settings Button -->
    <Grid Grid.Row="0" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
        <TextBlock Text="OpenRCT"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}" />
        <TextBlock Text="Manage single assets, multiple devices, or ConfigMgr collections directly, or open embedded dashboards."
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Margin="0,2,0,0" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="CheckUpdatesButton"
                Content="Check for Updates"
                Style="{DynamicResource StandardButton}"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                ToolTip="Check GitHub Releases for a newer version of OpenRCT"
                Click="CheckUpdates_Click" />

        <Button x:Name="SettingsButton"
                Width="36" Height="36"
                Padding="0"
                Style="{DynamicResource StandardButton}"
                ToolTip="OpenRCT Settings (PsExec, Theme, Connections &amp; Updates)"
                Click="Settings_Click">
          <Viewbox Width="18" Height="18">
            <Canvas Width="24" Height="24">
              <Path Fill="{DynamicResource PrimaryTextBrush}"
                    Data="M19.14,12.94 C19.18,12.64 19.2,12.33 19.2,12 C19.2,11.68 19.18,11.36 19.13,11.06 L21.16,9.48 C21.34,9.34 21.39,9.07 21.28,8.87 L19.36,5.55 C19.24,5.33 18.99,5.26 18.77,5.33 L16.38,6.29 C15.88,5.91 15.35,5.59 14.76,5.35 L14.4,2.81 C14.36,2.57 14.16,2.4 13.92,2.4 L10.08,2.4 C9.84,2.4 9.65,2.57 9.61,2.81 L9.25,5.35 C8.66,5.59 8.12,5.92 7.63,6.29 L5.24,5.33 C5.02,5.25 4.77,5.33 4.65,5.55 L2.74,8.87 C2.62,9.08 2.66,9.34 2.86,9.48 L4.89,11.06 C4.84,11.36 4.8,11.69 4.8,12 C4.8,12.31 4.82,12.64 4.87,12.94 L2.84,14.52 C2.66,14.66 2.61,14.93 2.72,15.13 L4.64,18.45 C4.76,18.67 5.01,18.74 5.23,18.67 L7.62,17.71 C8.12,18.09 8.65,18.41 9.24,18.65 L9.6,21.19 C9.65,21.43 9.84,21.6 10.08,21.6 L13.92,21.6 C14.16,21.6 14.36,21.43 14.39,21.19 L14.75,18.65 C15.34,18.41 15.88,18.09 16.37,17.71 L18.76,18.67 C18.98,18.75 19.23,18.67 19.35,18.45 L21.27,15.13 C21.39,14.91 21.34,14.66 21.15,14.52 L19.14,12.94 Z M12,15.6 C10.02,15.6 8.4,13.98 8.4,12 C8.4,10.02 10.02,8.4 12,8.4 C13.98,8.4 15.6,10.02 15.6,12 C15.6,13.98 13.98,15.6 12,15.6 Z" />
            </Canvas>
          </Viewbox>
        </Button>
      </StackPanel>
    </Grid>

    <!-- Target Picker: Manual Devices OR ConfigMgr Collection -->
    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="1" Padding="12" Margin="0,0,0,12">
      <StackPanel>
        <DockPanel Margin="0,0,0,8">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="TargetCountText" Text="0 targets" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <Button x:Name="ClearTargetsButton" Content="Clear" Padding="8,2" FontSize="11" Style="{DynamicResource StandardButton}" Click="ClearTargets_Click" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <RadioButton x:Name="TargetDevicesRadio" Content="Target Device(s)" IsChecked="True" Margin="0,0,16,0" VerticalAlignment="Center" Checked="TargetMode_Changed" />
            <RadioButton x:Name="TargetCollectionRadio" Content="ConfigMgr Device Collection" VerticalAlignment="Center" Checked="TargetMode_Changed" />
          </StackPanel>
        </DockPanel>

        <!-- Manual Devices Panel -->
        <StackPanel x:Name="ManualTargetsPanel">
          <TextBox x:Name="TargetsBox"
                   Height="54"
                   TextWrapping="Wrap"
                   AcceptsReturn="True"
                   VerticalScrollBarVisibility="Auto"
                   Padding="6"
                   ToolTip="Enter one or more hostnames or FQDNs separated by commas, semicolons, or new lines"
                   TextChanged="TargetsBox_TextChanged" />
        </StackPanel>

        <!-- Collection Selector Panel -->
        <DockPanel x:Name="CollectionTargetPanel" Visibility="Collapsed">
          <Button x:Name="RefreshCollectionsButton"
                  DockPanel.Dock="Right"
                  Content="Refresh"
                  Margin="8,0,0,0"
                  Style="{DynamicResource StandardButton}"
                  Click="RefreshCollections_Click" />
          <ComboBox x:Name="CollectionCombo"
                    IsEditable="True"
                    StaysOpenOnEdit="True"
                    Padding="6,4"
                    SelectionChanged="CollectionCombo_SelectionChanged" />
        </DockPanel>
      </StackPanel>
    </Border>

    <!-- Main Workspace: Full Categorized Searchable Tools (Left) + All 6 Dashboards (Right) -->
    <Grid Grid.Row="2" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.45*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="1*" />
      </Grid.ColumnDefinitions>

      <!-- Left: Full Tools Workspace -->
      <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="1" Padding="12">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBox x:Name="ToolSearchBox"
                     DockPanel.Dock="Right"
                     Width="210"
                     Padding="6,4"
                     ToolTip="Filter tools by name or category"
                     TextChanged="ToolSearchBox_TextChanged" />
            <TextBlock DockPanel.Dock="Right" Text="Filter:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBlock Text="Endpoint &amp; Management Tools" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
          </DockPanel>

          <!-- Search Results View (shown when ToolSearchBox has text) -->
          <ScrollViewer x:Name="SearchResultsScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="SearchResultsPanel" Orientation="Horizontal" />
          </ScrollViewer>

          <!-- Categorized Tabs (shown when ToolSearchBox is empty) -->
          <TabControl x:Name="ToolCategoryTabs" Background="Transparent" BorderBrush="{DynamicResource BorderBrushSubtle}">
            <TabItem Header="Quick Access">
              <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                <WrapPanel x:Name="QuickAccessPanel" Orientation="Horizontal" />
              </ScrollViewer>
            </TabItem>
            <TabItem Header="Remote Tools (10)">
              <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                <WrapPanel x:Name="RemoteToolsPanel" Orientation="Horizontal" />
              </ScrollViewer>
            </TabItem>
            <TabItem Header="Client Actions (12)">
              <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                <WrapPanel x:Name="ClientActionsPanel" Orientation="Horizontal" />
              </ScrollViewer>
            </TabItem>
            <TabItem Header="Client Tools (13)">
              <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                <WrapPanel x:Name="ClientToolsPanel" Orientation="Horizontal" />
              </ScrollViewer>
            </TabItem>
            <TabItem Header="Device &amp; Power (6)">
              <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                <WrapPanel x:Name="DevicePowerPanel" Orientation="Horizontal" />
              </ScrollViewer>
            </TabItem>
            <TabItem Header="Security (5)">
              <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                <WrapPanel x:Name="SecurityToolsPanel" Orientation="Horizontal" />
              </ScrollViewer>
            </TabItem>
            <TabItem Header="AD &amp; ConfigMgr (5)">
              <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                <WrapPanel x:Name="AdConfigMgrPanel" Orientation="Horizontal" />
              </ScrollViewer>
            </TabItem>
          </TabControl>
        </DockPanel>
      </Border>

      <!-- Right: All 6 Dashboards -->
      <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="1" Padding="12">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Dashboards" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10" />
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Button Style="{DynamicResource StandardButton}" HorizontalContentAlignment="Left" Padding="12,9" Margin="0,0,0,8" Tag="Dashboard.AdCleanup" Click="OpenDashboard_Click">
                <StackPanel>
                  <TextBlock Text="Active Directory Cleanup Tool" FontWeight="SemiBold" />
                  <TextBlock Text="Compare AD OUs against ConfigMgr collections" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
              </Button>

              <Button Style="{DynamicResource StandardButton}" HorizontalContentAlignment="Left" Padding="12,9" Margin="0,0,0,8" Tag="Dashboard.BitLockerCompliance" Click="OpenDashboard_Click">
                <StackPanel>
                  <TextBlock Text="BitLocker Compliance" FontWeight="SemiBold" />
                  <TextBlock Text="Audit recovery key storage and encryption state" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
              </Button>

              <Button Style="{DynamicResource StandardButton}" HorizontalContentAlignment="Left" Padding="12,9" Margin="0,0,0,8" Tag="Dashboard.ContentDistribution" Click="OpenDashboard_Click">
                <StackPanel>
                  <TextBlock Text="Content Distribution Monitor" FontWeight="SemiBold" />
                  <TextBlock Text="Inspect DPs, view status, redistribute &amp; validate" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
              </Button>

              <Button Style="{DynamicResource StandardButton}" HorizontalContentAlignment="Left" Padding="12,9" Margin="0,0,0,8" Tag="Dashboard.HardwareFirmwareAudit" Click="OpenDashboard_Click">
                <StackPanel>
                  <TextBlock Text="Hardware and Firmware Audit" FontWeight="SemiBold" />
                  <TextBlock Text="Chassis, models, UEFI, Secure Boot, TPM &amp; BIOS" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
              </Button>

              <Button Style="{DynamicResource StandardButton}" HorizontalContentAlignment="Left" Padding="12,9" Margin="0,0,0,8" Tag="Dashboard.Laps" Click="OpenDashboard_Click">
                <StackPanel>
                  <TextBlock Text="LAPS Dashboard" FontWeight="SemiBold" />
                  <TextBlock Text="Legacy &amp; Windows LAPS passwords and client state" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
              </Button>

              <Button Style="{DynamicResource StandardButton}" HorizontalContentAlignment="Left" Padding="12,9" Tag="Dashboard.SoftwareUpdates" Click="OpenDashboard_Click">
                <StackPanel>
                  <TextBlock Text="Software Updates Deployment Status" FontWeight="SemiBold" />
                  <TextBlock Text="Collection update compliance and missing patches" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Status & Utilities Footer -->
    <DockPanel Grid.Row="3">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="View Install Log" Style="{DynamicResource StandardButton}" Margin="0,0,6,0" Click="ViewInstallLog_Click" />
        <Button Content="Repair MECM Console Extension" Style="{DynamicResource StandardButton}" Click="RepairConsoleExtension_Click" />
      </StackPanel>
      <TextBlock x:Name="FooterStatusText"
                 FontSize="11"
                 Foreground="{DynamicResource SecondaryTextBrush}"
                 VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis"
                 Margin="0,0,12,0" />
    </DockPanel>
  </Grid>
</Window>
