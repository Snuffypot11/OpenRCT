<Window x:Class="OpenRCT.App.MainLauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenRCT — Open Source Right Click Tools for MECM"
        Width="780" Height="560"
        MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,14">
      <Button Content="Settings (PsExec &amp; Preferences)" DockPanel.Dock="Right" Style="{StaticResource StandardButton}" Click="Settings_Click" />
      <StackPanel>
        <TextBlock Text="OpenRCT Standalone Launcher" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
        <TextBlock Text="Manage single or multiple MECM assets directly or launch embedded dashboards outside the console."
                   FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0" />
      </StackPanel>
    </DockPanel>

    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="1" Padding="12" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="Target Device(s) — comma, semicolon, or newline separated:" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBox x:Name="TargetsBox" Height="62" TextWrapping="Wrap" AcceptsReturn="True" Padding="6" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="2" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="1" Padding="12">
        <StackPanel>
          <TextBlock Text="Quick Tools" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
          <Button Content="System Information (10 Tabs)" Style="{StaticResource PrimaryButton}" Margin="0,0,0,6" Tag="ConsoleTool.SystemInformation" Click="RunTool_Click" />
          <Button Content="Client Information" Style="{StaticResource StandardButton}" Margin="0,0,0,6" Tag="ClientTool.ClientInformation" Click="RunTool_Click" />
          <Button Content="Remote Software Center" Style="{StaticResource StandardButton}" Margin="0,0,0,6" Tag="ClientTool.RemoteSoftwareCenter" Click="RunTool_Click" />
          <Button Content="Machine Policy Retrieval &amp; Evaluation" Style="{StaticResource StandardButton}" Margin="0,0,0,6" Tag="ClientAction.MachinePolicyRetrievalAndEval" Click="RunTool_Click" />
          <Button Content="Ping System(s)" Style="{StaticResource StandardButton}" Margin="0,0,0,6" Tag="ConsoleTool.PingSystems" Click="RunTool_Click" />
          <Button Content="Running Processes" Style="{StaticResource StandardButton}" Margin="0,0,0,6" Tag="ConsoleTool.RunningProcesses" Click="RunTool_Click" />
          <Button Content="Interactive Command Prompt (PsExec)" Style="{StaticResource StandardButton}" Margin="0,0,0,6" Tag="ConsoleTool.InteractiveCommandPrompt" Click="RunTool_Click" />
          <Button Content="View LAPS Password" Style="{StaticResource StandardButton}" Tag="SecurityTool.ViewLapsPassword" Click="RunTool_Click" />
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="1" Padding="12">
        <StackPanel>
          <TextBlock Text="Dashboards" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
          <Button Content="Active Directory Cleanup Tool" Style="{StaticResource StandardButton}" Margin="0,0,0,6" Tag="Dashboard.AdCleanup" Click="OpenDashboard_Click" />
          <Button Content="LAPS Dashboard" Style="{StaticResource StandardButton}" Margin="0,0,0,6" Tag="Dashboard.Laps" Click="OpenDashboard_Click" />
          <Button Content="Software Updates Deployment Status" Style="{StaticResource StandardButton}" Margin="0,0,0,6" Tag="Dashboard.SoftwareUpdates" Click="OpenDashboard_Click" />
          <Separator Margin="0,6" />
          <TextBlock Text="Phase 2 Dashboards (Roadmap)" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,6" />
          <Button Content="BitLocker Compliance" Style="{StaticResource StandardButton}" Margin="0,0,0,6" Tag="Dashboard.BitLockerCompliance" Click="OpenDashboard_Click" />
          <Button Content="Content Distribution Monitor" Style="{StaticResource StandardButton}" Margin="0,0,0,6" Tag="Dashboard.ContentDistribution" Click="OpenDashboard_Click" />
          <Button Content="Hardware and Firmware Audit" Style="{StaticResource StandardButton}" Tag="Dashboard.HardwareFirmwareAudit" Click="OpenDashboard_Click" />
        </StackPanel>
      </Border>
    </Grid>

    <TextBlock Grid.Row="3" Text="OpenRCT — MIT Licensed Open Source Project • Zero Ads • Optional PsExec Only"
               FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" />
  </Grid>
</Window>
