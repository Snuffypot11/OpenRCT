<?xml version="1.0" encoding="utf-8"?>
<!--
  OpenRCT Console Tree Nodes under Assets and Compliance -> Overview
  Deployed by installer to:
    <AdminConsole>\XmlStorage\Extensions\Nodes\<AssetsOverviewNodeGuid>\OpenRCT_Nodes.xml
  NOTE: All 6 dashboards sit directly under OpenRCT (no extra Right Click Tools nesting layer).
-->
<RootNodeDescription NamespaceGuid="b7f2b410-91b5-4c8a-88a1-000000000001"
                     Id="OpenRctRootNode"
                     DisplayName="OpenRCT"
                     Description="Open Source Right Click Tools and Dashboards">
  <ViewAssemblyDescriptions>
    <ViewAssemblyDescription>
      <Assembly>OpenRCT.ConsoleExtension.dll</Assembly>
      <Type>OpenRCT.ConsoleExtension.OpenRctHomeConsoleView</Type>
    </ViewAssemblyDescription>
  </ViewAssemblyDescriptions>
  <Actions>
    <ActionDescription Class="Executable" DisplayName="Open OpenRCT Standalone App" MnemonicDisplayName="Open OpenRCT Standalone App" Description="Launch OpenRCT standalone dashboard and tool window">
      <ShowOn><string>ContextMenu</string><string>DefaultHomeTab</string></ShowOn>
      <Executable><FilePath>{{OPENRCT_INSTALL_DIR}}\OpenRCT.App.exe</FilePath><Parameters></Parameters></Executable>
    </ActionDescription>
  </Actions>
  <ChildNodes>
    <RootNodeDescription NamespaceGuid="b7f2b410-91b5-4c8a-88a1-000000000101"
                         Id="OpenRctAdCleanupNode"
                         DisplayName="Active Directory Cleanup Tool"
                         Description="Compare devices in Active Directory and ConfigMgr">
      <ViewAssemblyDescriptions>
        <ViewAssemblyDescription>
          <Assembly>OpenRCT.ConsoleExtension.dll</Assembly>
          <Type>OpenRCT.ConsoleExtension.AdCleanupConsoleView</Type>
        </ViewAssemblyDescription>
      </ViewAssemblyDescriptions>
      <Actions>
        <ActionDescription Class="Executable" DisplayName="Open in New Window" MnemonicDisplayName="Open in New Window" Description="Open Active Directory Cleanup Tool in a separate window">
          <ShowOn><string>ContextMenu</string><string>DefaultHomeTab</string></ShowOn>
          <Executable><FilePath>{{OPENRCT_INSTALL_DIR}}\OpenRCT.App.exe</FilePath><Parameters>--action Dashboard.AdCleanup</Parameters></Executable>
        </ActionDescription>
      </Actions>
    </RootNodeDescription>

