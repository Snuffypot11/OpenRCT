<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="OpenRCT — Open Source Right Click Tools for MECM"
           Manufacturer="OpenRCT Contributors"
           Version="0.1.2.0"
           UpgradeCode="9f41d2e8-5c3a-4b11-9a10-7e4b6c112201"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of OpenRCT is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Optional silent install properties: msiexec /i OpenRCT.msi /qn PSEXECPATH="C:\Tools\PsExec64.exe" -->
    <Property Id="PSEXECPATH" Secure="yes" />
    <Property Id="CONSOLEROOT" Secure="yes" />
    <Property Id="INSTALLMODE" Value="Assembly" Secure="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="OpenRCT">
        <Directory Id="ScriptsFolder" Name="scripts" />
        <Directory Id="BridgeSrcFolder" Name="console-bridge-src" />
        <Directory Id="ConsoleExtRootFolder" Name="console-extensions">
          <Directory Id="XmlStorageFolder" Name="XmlStorage">
            <Directory Id="XmlExtensionsFolder" Name="Extensions">
              <Directory Id="XmlActionsFolder" Name="Actions" />
              <Directory Id="XmlNodesFolder" Name="Nodes" />
            </Directory>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="OpenRctMenuFolder" Name="OpenRCT" />
    </StandardDirectory>

    <Feature Id="MainFeature" Title="OpenRCT Core &amp; MECM Console Extensions" Level="1">
      <ComponentGroupRef Id="AppBinaries" />
      <ComponentGroupRef Id="InstallerAssets" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <ComponentGroup Id="AppBinaries" Directory="INSTALLFOLDER">
      <Component Id="OpenRctCoreDll" Guid="9f41d2e8-5c3a-4b11-9a10-7e4b6c112211">
        <File Source="$(var.OpenRCT.App.TargetDir)OpenRCT.Core.dll" KeyPath="yes" />
      </Component>
      <Component Id="OpenRctConnectorsDll" Guid="9f41d2e8-5c3a-4b11-9a10-7e4b6c112212">
        <File Source="$(var.OpenRCT.App.TargetDir)OpenRCT.Connectors.dll" KeyPath="yes" />
      </Component>
      <Component Id="OpenRctUiDll" Guid="9f41d2e8-5c3a-4b11-9a10-7e4b6c112213">
        <File Source="$(var.OpenRCT.App.TargetDir)OpenRCT.UI.dll" KeyPath="yes" />
      </Component>
      <Component Id="OpenRctAppExe" Guid="9f41d2e8-5c3a-4b11-9a10-7e4b6c112214">
        <File Id="OpenRctAppExeFile" Source="$(var.OpenRCT.App.TargetDir)OpenRCT.App.exe" KeyPath="yes" />
      </Component>
      <Component Id="OpenRctConsoleExtDll" Guid="9f41d2e8-5c3a-4b11-9a10-7e4b6c112215">
        <File Source="$(var.OpenRCT.ConsoleExtension.TargetDir)OpenRCT.ConsoleExtension.dll" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="InstallerAssets">
      <Component Id="InstallScript" Directory="ScriptsFolder" Guid="9f41d2e8-5c3a-4b11-9a10-7e4b6c112221">
        <File Source="..\scripts\Install-OpenRCT.ps1" KeyPath="yes" />
      </Component>
      <Component Id="UninstallScript" Directory="ScriptsFolder" Guid="9f41d2e8-5c3a-4b11-9a10-7e4b6c112222">
        <File Source="..\scripts\Uninstall-OpenRCT.ps1" KeyPath="yes" />
      </Component>
      <Component Id="BridgeHandlerCs" Directory="BridgeSrcFolder" Guid="9f41d2e8-5c3a-4b11-9a10-7e4b6c112223">
        <File Source="..\..\src\OpenRCT.ConsoleExtension\OpenRctActionHandler.cs" KeyPath="yes" />
      </Component>
      <Component Id="BridgeViewsCs" Directory="BridgeSrcFolder" Guid="9f41d2e8-5c3a-4b11-9a10-7e4b6c112224">
        <File Source="..\..\src\OpenRCT.ConsoleExtension\DashboardConsoleViews.cs" KeyPath="yes" />
      </Component>
      <Component Id="DeviceActionsXml" Directory="XmlActionsFolder" Guid="9f41d2e8-5c3a-4b11-9a10-7e4b6c112225">
        <File Source="..\..\console-extensions\XmlStorage\Extensions\Actions\OpenRCT_DeviceActions.xml" KeyPath="yes" />
      </Component>
      <Component Id="CollectionActionsXml" Directory="XmlActionsFolder" Guid="9f41d2e8-5c3a-4b11-9a10-7e4b6c112226">
        <File Source="..\..\console-extensions\XmlStorage\Extensions\Actions\OpenRCT_CollectionActions.xml" KeyPath="yes" />
      </Component>
      <Component Id="ExecutableActionsXml" Directory="XmlActionsFolder" Guid="9f41d2e8-5c3a-4b11-9a10-7e4b6c112227">
        <File Source="..\..\console-extensions\XmlStorage\Extensions\Actions\OpenRCT_DeviceActions_Executable.xml" KeyPath="yes" />
      </Component>
      <Component Id="ConsoleNodesXml" Directory="XmlNodesFolder" Guid="9f41d2e8-5c3a-4b11-9a10-7e4b6c112228">
        <File Source="..\..\console-extensions\XmlStorage\Extensions\Nodes\OpenRCT_Nodes.xml" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Component Id="StartMenuShortcut" Directory="OpenRctMenuFolder" Guid="9f41d2e8-5c3a-4b11-9a10-7e4b6c112230">
      <Shortcut Id="OpenRctShortcut"
                Name="OpenRCT"
                Description="Open Source Right Click Tools for Microsoft Configuration Manager"
                Target="[#OpenRctAppExeFile]"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveOpenRctMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\OpenRCT" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Register & unregister MECM Console XML extensions cleanly (trailing '.' prevents \" quote-escaping in powershell.exe) -->
    <CustomAction Id="RegisterConsoleExtensions"
                  Directory="INSTALLFOLDER"
                  ExeCommand="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;[ScriptsFolder]Install-OpenRCT.ps1&quot; -InstallDir &quot;[INSTALLFOLDER].&quot; -Mode &quot;[INSTALLMODE]&quot; -ConsoleRoot &quot;[CONSOLEROOT]&quot; -PsExecPath &quot;[PSEXECPATH]&quot; -SkipBinaryCopy"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="UnregisterConsoleExtensions"
                  Directory="INSTALLFOLDER"
                  ExeCommand="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;[ScriptsFolder]Uninstall-OpenRCT.ps1&quot; -InstallDir &quot;[INSTALLFOLDER].&quot; -ConsoleRoot &quot;[CONSOLEROOT]&quot; -SkipBinaryRemove"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="RegisterConsoleExtensions" After="InstallFiles" Condition="NOT Installed OR REINSTALL" />
      <Custom Action="UnregisterConsoleExtensions" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Package>
</Wix>
